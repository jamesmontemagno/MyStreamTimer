<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);WINDOWS_STABILITY_STUBS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyStreamTimer.Core\MyStreamTimer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test the Windows adapter's managed logic with test-only OS/diagnostics doubles. -->
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\LocalSettingsStore.cs" Link="WindowsStability\LocalSettingsStore.cs" />
    <Compile Include="..\WindowsStability\LocalSettingsStoreTests.cs" Link="WindowsStability\LocalSettingsStoreTests.cs" />
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\ActivationRedirection.cs" Link="WindowsStability\ActivationRedirection.cs" />
    <Compile Include="..\WindowsStability\ActivationRedirectionTests.cs" Link="WindowsStability\ActivationRedirectionTests.cs" />
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\SettingsResetConfirmation.cs" Link="WindowsStability\SettingsResetConfirmation.cs" />
    <Compile Include="..\WindowsStability\SettingsResetConfirmationTests.cs" Link="WindowsStability\SettingsResetConfirmationTests.cs" />
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\FolderService.cs" Link="WindowsStability\FolderService.cs" />
    <Compile Include="..\WindowsStability\FolderServiceTests.cs" Link="WindowsStability\FolderServiceTests.cs" />
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\StoreService.cs" Link="WindowsStability\StoreService.cs" />
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\StoreLicenseRefreshOutcome.cs" Link="WindowsStability\StoreLicenseRefreshOutcome.cs" />
    <Compile Include="..\..\src\MyStreamTimer.WinUI\Services\ShellServices.cs" Link="WindowsStability\ShellServices.cs" />
    <Compile Include="..\WindowsStability\StoreAndLauncherTests.cs" Link="WindowsStability\StoreAndLauncherTests.cs" />
    <Compile Include="..\WindowsStability\StoreAndLauncherTestDoubles.cs" Link="WindowsStability\StoreAndLauncherTestDoubles.cs" />
  </ItemGroup>
</Project>
