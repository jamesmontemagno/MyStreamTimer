<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyStreamTimer.WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyStreamTimer.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MyStreamTimer.WinUI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,24,0,8" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1000"
            Padding="36,24,36,36"
            HorizontalAlignment="Left"
            Spacing="4">

            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="About" />

            <!--  ======================= Hero ======================= -->
            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="96"
                        Height="96"
                        VerticalAlignment="Top"
                        CornerRadius="16">
                        <Image
                            AutomationProperties.Name="My Stream Timer app icon"
                            Source="ms-appx:///Assets/StoreLogo.scale-200.png"
                            Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            AutomationProperties.AutomationId="AboutAppName"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.AppName}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="AboutVersion"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.Version}" />
                            <Button
                                Padding="6"
                                AutomationProperties.AutomationId="CopyVersionButton"
                                AutomationProperties.Name="Copy version"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{x:Bind ViewModel.CopyVersionCommand}"
                                ToolTipService.ToolTip="Copy version">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="Version copied" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Blurb}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ======================= Links ======================= -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Links" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Links}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="8"
                        MinItemWidth="220"
                        MinRowSpacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LinkItem">
                        <Button
                            Padding="16,12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="{x:Bind AutomationName}"
                            Command="{x:Bind OpenCommand}"
                            CommandParameter="{x:Bind Url}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Title}" />
                                <FontIcon
                                    Grid.Column="2"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE8A7;" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  ======================= Diagnostics ======================= -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Diagnostics" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Crash logs" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="If something goes wrong, a log is written here. Attach it when reporting an issue on GitHub."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OpenCrashLogsButton"
                        AutomationProperties.Name="Open crash logs folder"
                        Command="{x:Bind ViewModel.OpenLogsFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE838;" />
                            <TextBlock Text="Open crash logs folder" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <InfoBar
                AutomationProperties.AutomationId="AboutStatusInfoBar"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="Warning" />

            <TextBlock
                Margin="0,24,0,0"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="© Refractored LLC. Built with WinUI 3 and the Windows App SDK." />
        </StackPanel>
    </ScrollViewer>
</Page>
