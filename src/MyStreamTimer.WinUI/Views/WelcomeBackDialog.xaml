<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MyStreamTimer.WinUI.Views.WelcomeBackDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="What's new in 3.1.0"
    AutomationProperties.AutomationId="WelcomeBackDialog"
    DefaultButton="Primary"
    PrimaryButtonText="Continue"
    SecondaryButtonText="Learn about Pro"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel MaxWidth="440" Spacing="20">
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            Text="Here's what was added to My Stream Timer in this update."
            TextWrapping="Wrap" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Width="40"
                Height="40"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="8">
                <FontIcon Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE995;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Custom end sounds" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Give each timer its own sound: Chime, Bell, Digital, or your own MP3 or WAV."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </StackPanel>
</ContentDialog>
