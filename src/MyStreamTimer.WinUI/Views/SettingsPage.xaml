<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MyStreamTimer.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MyStreamTimer.WinUI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:MyStreamTimer.WinUI.ViewModels"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="1,24,0,8" />
        </Style>
        <Style x:Key="SwatchBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1000"
            Padding="36,24,36,36"
            HorizontalAlignment="Left"
            Spacing="4">

            <TextBlock
                Margin="0,0,0,8"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!--  ======================= Output folder ======================= -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Output folder" />

            <controls:SettingsExpander
                x:Name="OutputFolderExpander"
                AutomationProperties.AutomationId="OutputFolderExpander"
                AutomationProperties.Name="Output folder"
                Description="{x:Bind ViewModel.DirectoryPath, Mode=OneWay}"
                Header="Output folder"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.TimerFiles, Mode=OneWay}">
                <Button
                    AutomationProperties.AutomationId="ChooseFolderButton"
                    AutomationProperties.Name="Choose folder"
                    Command="{x:Bind ViewModel.ChooseFolderCommand}"
                    Content="Choose folder"
                    IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsFolderBusy), Mode=OneWay}" />

                <controls:SettingsExpander.ItemsHeader>
                    <StackPanel Padding="44,12,44,12" Spacing="12">
                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button
                                AutomationProperties.AutomationId="OpenFolderButton"
                                AutomationProperties.Name="Open folder in Explorer"
                                Command="{x:Bind ViewModel.OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    <TextBlock Text="Open in Explorer" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="TestAccessButton"
                                AutomationProperties.Name="Test folder access"
                                Command="{x:Bind ViewModel.TestAccessCommand}"
                                IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsFolderBusy), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE9D5;" />
                                    <TextBlock Text="Test access" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="UseDefaultFolderButton"
                                AutomationProperties.Name="Use default folder"
                                Command="{x:Bind ViewModel.UseDefaultCommand}"
                                IsEnabled="{x:Bind local:SettingsPage.CanUseDefault(ViewModel.IsDefaultDirectory, ViewModel.IsFolderBusy), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                                    <TextBlock Text="Use default" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="CopyFolderPathButton"
                                AutomationProperties.Name="Copy folder path"
                                Command="{x:Bind ViewModel.CopyPathCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                    <TextBlock Text="Copy path" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <TextBlock Text="Path copied" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <ProgressRing
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsFolderBusy, Mode=OneWay}" />
                        </controls:WrapPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Each timer writes its text to one of these files. Point OBS, Streamlabs or any overlay at them." />
                    </StackPanel>
                </controls:SettingsExpander.ItemsHeader>

                <controls:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimerFileItem">
                        <controls:SettingsCard
                            AutomationProperties.Name="{x:Bind Title}"
                            Description="{x:Bind FullPath}"
                            Header="{x:Bind Title}">
                            <Button
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Command="{x:Bind CopyCommand}"
                                CommandParameter="{x:Bind FullPath}"
                                ToolTipService.ToolTip="Copy file path">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                <Button.Flyout>
                                    <Flyout Placement="Left">
                                        <TextBlock Text="Path copied" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </controls:SettingsCard>
                    </DataTemplate>
                </controls:SettingsExpander.ItemTemplate>
            </controls:SettingsExpander>

            <InfoBar
                AutomationProperties.AutomationId="FolderStatusInfoBar"
                IsOpen="{x:Bind ViewModel.IsFolderStatusOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.FolderStatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.FolderStatusSeverity, Mode=OneWay}" />

            <!--  ======================= Timers ======================= -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Timers" />

            <controls:SettingsExpander
                x:Name="TimersExpander"
                AutomationProperties.AutomationId="TimersExpander"
                AutomationProperties.Name="Timers"
                Description="Rename timers and choose icons"
                Header="Timers"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8AC;}"
                IsExpanded="True"
                ItemsSource="{x:Bind ViewModel.TimerAppearances, Mode=OneWay}">
                <controls:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimerAppearanceItem">
                        <controls:SettingsCard
                            AutomationProperties.Name="{x:Bind EffectiveTitle, Mode=OneWay}"
                            Description="{x:Bind Description}"
                            Header="{x:Bind EffectiveTitle, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{x:Bind EffectiveGlyph, Mode=OneWay}" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <DropDownButton
                                    AutomationProperties.AutomationId="{x:Bind IconAutomationId}"
                                    AutomationProperties.Name="Choose icon"
                                    ToolTipService.ToolTip="Choose icon">
                                    <FontIcon FontSize="16" Glyph="{x:Bind EffectiveGlyph, Mode=OneWay}" />
                                    <DropDownButton.Flyout>
                                        <Flyout
                                            Closed="OnIconFlyoutClosed"
                                            Opened="OnIconFlyoutOpened"
                                            Placement="Bottom">
                                            <GridView
                                                MaxWidth="240"
                                                AutomationProperties.Name="Timer icons"
                                                IsItemClickEnabled="True"
                                                ItemClick="OnIconItemClick"
                                                ItemsSource="{x:Bind IconChoices}"
                                                SelectionMode="Single"
                                                Tag="{x:Bind}">
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                                <GridView.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:IconChoice">
                                                        <FontIcon
                                                            Width="40"
                                                            Height="40"
                                                            AutomationProperties.Name="{x:Bind Label}"
                                                            FontSize="20"
                                                            Glyph="{x:Bind Glyph}"
                                                            ToolTipService.ToolTip="{x:Bind Label}" />
                                                    </DataTemplate>
                                                </GridView.ItemTemplate>
                                            </GridView>
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <TextBox
                                    Width="200"
                                    AutomationProperties.AutomationId="{x:Bind NameAutomationId}"
                                    AutomationProperties.Name="Timer name"
                                    MaxLength="40"
                                    PlaceholderText="{x:Bind DefaultTitle}"
                                    Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind ResetAutomationId}"
                                    AutomationProperties.Name="Reset name and icon"
                                    Command="{x:Bind ResetCommand}"
                                    Content="Reset"
                                    ToolTipService.ToolTip="Restore the default name and icon" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </DataTemplate>
                </controls:SettingsExpander.ItemTemplate>
            </controls:SettingsExpander>

            <!--  ======================= Appearance ======================= -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" />

            <controls:SettingsCard
                AutomationProperties.Name="Theme"
                ContentAlignment="Vertical"
                Description="Choose how My Stream Timer looks. System follows your Windows setting."
                Header="Theme"
                HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                <RadioButtons
                    Margin="0,8,0,0"
                    AutomationProperties.AutomationId="ThemeRadioButtons"
                    AutomationProperties.Name="Theme"
                    MaxColumns="3"
                    SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                    <RadioButton AutomationProperties.AutomationId="ThemeSystem" Content="System" />
                    <RadioButton AutomationProperties.AutomationId="ThemeLight" Content="Light" />
                    <RadioButton AutomationProperties.AutomationId="ThemeDark" Content="Dark" />
                </RadioButtons>
            </controls:SettingsCard>

            <controls:SettingsCard
                AutomationProperties.Name="Stay on top"
                Description="Keep the app and any pop-out timers above other windows."
                Header="Stay on top"
                HeaderIcon="{ui:FontIcon Glyph=&#xE840;}">
                <ToggleSwitch
                    AutomationProperties.AutomationId="StayOnTopToggle"
                    AutomationProperties.Name="Stay on top"
                    IsOn="{x:Bind ViewModel.StayOnTop, Mode=TwoWay}" />
            </controls:SettingsCard>

            <!--  ======================= Pop-out appearance (Pro) ======================= -->
            <StackPanel Margin="1,24,0,8" Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Pop-out appearance" />
                <Border
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="10">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Pro" />
                </Border>
            </StackPanel>

            <controls:SettingsExpander
                AutomationProperties.AutomationId="PopOutAppearanceExpander"
                AutomationProperties.Name="Pop-out appearance"
                Description="Font, size and colours used by the pop-out timer windows."
                Header="Pop-out appearance"
                HeaderIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                IsExpanded="True">
                <controls:SettingsExpander.Items>
                    <!--  Locked state  -->
                    <controls:SettingsCard
                        AutomationProperties.Name="Pop-out appearance is a Pro feature"
                        Description="Unlock pop-out timer windows and customise their look with Pro."
                        Header="Pop-out appearance is a Pro feature"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE72E;}"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsNotPro), Mode=OneWay}">
                        <Button
                            AutomationProperties.AutomationId="UpgradeToProButton"
                            AutomationProperties.Name="Upgrade to Pro"
                            Command="{x:Bind ViewModel.GoToProCommand}"
                            Content="Upgrade to Pro"
                            Style="{StaticResource AccentButtonStyle}" />
                    </controls:SettingsCard>

                    <!--  Font size  -->
                    <controls:SettingsCard
                        AutomationProperties.Name="Font size"
                        Description="Text is scaled down automatically if the window is too small."
                        Header="Font size"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsPro), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider
                                Width="220"
                                AutomationProperties.AutomationId="PopOutFontSizeSlider"
                                AutomationProperties.Name="Pop-out font size"
                                Maximum="200"
                                Minimum="12"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.PopOutFontSize, Mode=TwoWay}" />
                            <TextBlock
                                MinWidth="48"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.FontSizeLabel, Mode=OneWay}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!--  Font family  -->
                    <controls:SettingsCard
                        AutomationProperties.Name="Font"
                        Header="Font"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsPro), Mode=OneWay}">
                        <ComboBox
                            MinWidth="240"
                            AutomationProperties.AutomationId="PopOutFontComboBox"
                            AutomationProperties.Name="Pop-out font"
                            ItemsSource="{x:Bind ViewModel.FontOptions}"
                            SelectedItem="{x:Bind ViewModel.SelectedFont, Mode=TwoWay}" />
                    </controls:SettingsCard>

                    <!--  Text colour  -->
                    <controls:SettingsCard
                        AutomationProperties.Name="Text colour"
                        Header="Text colour"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsPro), Mode=OneWay}">
                        <DropDownButton AutomationProperties.AutomationId="PopOutTextColorButton" AutomationProperties.Name="Pop-out text colour">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{x:Bind ViewModel.TextColorBrush, Mode=OneWay}" Style="{StaticResource SwatchBorderStyle}" />
                                <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.TextColorHex, Mode=OneWay}" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <ColorPicker
                                        AutomationProperties.AutomationId="PopOutTextColorPicker"
                                        AutomationProperties.Name="Text colour picker"
                                        Color="{x:Bind ViewModel.TextColor, Mode=TwoWay}"
                                        ColorSpectrumShape="Ring"
                                        IsAlphaEnabled="False"
                                        IsColorChannelTextInputVisible="False"
                                        IsHexInputVisible="True"
                                        IsMoreButtonVisible="False" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </controls:SettingsCard>

                    <!--  Background colour  -->
                    <controls:SettingsCard
                        AutomationProperties.Name="Background colour"
                        Header="Background colour"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsPro), Mode=OneWay}">
                        <DropDownButton AutomationProperties.AutomationId="PopOutBackgroundColorButton" AutomationProperties.Name="Pop-out background colour">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="{x:Bind ViewModel.BackgroundColorBrush, Mode=OneWay}" Style="{StaticResource SwatchBorderStyle}" />
                                <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.BackgroundColorHex, Mode=OneWay}" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="Bottom">
                                    <ColorPicker
                                        AutomationProperties.AutomationId="PopOutBackgroundColorPicker"
                                        AutomationProperties.Name="Background colour picker"
                                        Color="{x:Bind ViewModel.BackgroundColor, Mode=TwoWay}"
                                        ColorSpectrumShape="Ring"
                                        IsAlphaEnabled="False"
                                        IsColorChannelTextInputVisible="False"
                                        IsHexInputVisible="True"
                                        IsMoreButtonVisible="False" />
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </controls:SettingsCard>

                    <!--  Live preview  -->
                    <controls:SettingsCard
                        AutomationProperties.Name="Preview"
                        ContentAlignment="Vertical"
                        Description="This is how the pop-out window will look."
                        Header="Preview"
                        Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.IsPro), Mode=OneWay}">
                        <Border
                            Height="120"
                            MaxWidth="400"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Background="{x:Bind ViewModel.BackgroundColorBrush, Mode=OneWay}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Viewbox Margin="12" StretchDirection="DownOnly">
                                <TextBlock
                                    AutomationProperties.AutomationId="PopOutPreviewText"
                                    FontFamily="{x:Bind ViewModel.PreviewFontFamily, Mode=OneWay}"
                                    FontSize="{x:Bind ViewModel.PopOutFontSize, Mode=OneWay}"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.TextColorBrush, Mode=OneWay}"
                                    Text="12:34" />
                            </Viewbox>
                        </Border>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <!--  ======================= Data ======================= -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Data" />

            <controls:SettingsCard
                AutomationProperties.Name="Reset all settings"
                Description="Restore every timer, the output folder, theme and pop-out appearance to defaults. Pro purchases are kept."
                Header="Reset all settings"
                HeaderIcon="{ui:FontIcon Glyph=&#xE777;}">
                <Button
                    AutomationProperties.AutomationId="ResetAllSettingsButton"
                    AutomationProperties.Name="Reset all settings"
                    Command="{x:Bind ViewModel.ResetAllSettingsCommand}"
                    Content="Reset…" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
